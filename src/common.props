<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <!-- Solution-wide properties for NuGet packaging -->
    <PropertyGroup>
		<VersionPrefix Condition="'$(VersionPrefix)' == ''">$([System.DateTime]::Now.ToString("yyyy.MMdd.HHmm"))</VersionPrefix>
		<Version Condition="'$(Version)' == ''">$(VersionPrefix)</Version>
		<PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
		<AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
		<AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$([System.DateTime]::Now.ToString("0.yyyy.MMdd.HHmm"))</AssemblyVersion>
		<FileVersion Condition="'$(FileVersion)' == ''">$([System.DateTime]::Now.ToString("0.yyyy.MMdd.HHmm"))</FileVersion>
		<Authors>GinoCanessa</Authors>
		<Company>Gino Canessa</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	    <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright 2026+</Copyright>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/GinoCanessa/dotnet-fhir-packages</RepositoryUrl>
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\">
			<Link>LICENSE</Link>
		</None>
		<None Include="..\..\README.md" Pack="true" PackagePath="\">
			<Link>README.md</Link>
		</None>
		<None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\">
			<Link>CHANGELOG.md</Link>
		</None>
	</ItemGroup>

</Project>
