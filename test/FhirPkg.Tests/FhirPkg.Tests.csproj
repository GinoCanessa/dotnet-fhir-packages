<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
    <RootNamespace>FhirPkg.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FhirPkg\FhirPkg.csproj" />
    <ProjectReference Include="..\..\tools\FhirPkg.Release\FhirPkg.Release.csproj" />
    <ProjectReference Include="..\FhirPkg.Qualification\FhirPkg.Qualification.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\..\Directory.Build.props"
      Link="BuildContracts\Directory.Build.props"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\global.json"
      Link="BuildContracts\global.json"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\src\common.props"
      Link="BuildContracts\src\common.props"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\src\FhirPkg\FhirPkg.csproj"
      Link="BuildContracts\src\FhirPkg\FhirPkg.csproj"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\src\FhirPkg.Cli\FhirPkg.Cli.csproj"
      Link="BuildContracts\src\FhirPkg.Cli\FhirPkg.Cli.csproj"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="FhirPkg.Tests.csproj"
      Link="BuildContracts\test\FhirPkg.Tests\FhirPkg.Tests.csproj"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\FhirPkg.IntegrationTests\FhirPkg.IntegrationTests.csproj"
      Link="BuildContracts\test\FhirPkg.IntegrationTests\FhirPkg.IntegrationTests.csproj"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\FhirPkg.ProcessTestHost\FhirPkg.ProcessTestHost.csproj"
      Link="BuildContracts\test\FhirPkg.ProcessTestHost\FhirPkg.ProcessTestHost.csproj"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\FhirPkg.Qualification\FhirPkg.Qualification.csproj"
      Link="BuildContracts\test\FhirPkg.Qualification\FhirPkg.Qualification.csproj"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\tools\FhirPkg.Release\FhirPkg.Release.csproj"
      Link="BuildContracts\tools\FhirPkg.Release\FhirPkg.Release.csproj"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\.github\scripts\Test-QualificationRestore.ps1"
      Link="BuildContracts\.github\scripts\Test-QualificationRestore.ps1"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\.github\scripts\Test-ToolQualification.ps1"
      Link="BuildContracts\.github\scripts\Test-ToolQualification.ps1"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\..\.github\workflows\build-and-test.yaml"
      Link="ReleaseContracts\build-and-test.yaml"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\.github\workflows\fixture-drift.yaml"
      Link="ReleaseContracts\fixture-drift.yaml"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\.github\workflows\nuget-generator.yaml"
      Link="ReleaseContracts\nuget-generator.yaml"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\docs\releases\approvals\*.json"
      Link="ReleaseContracts\approvals\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\..\test\FhirPkg.Qualification\FhirPkg.Qualification.csproj"
      Link="ReleaseContracts\FhirPkg.Qualification.csproj"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
